{
  "name": "discord-ai-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A natural Discord AI companion powered by DeepSeek, with optional Gemini video understanding.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "discord.js": "14.28.0",
    "dotenv": "18.0.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
