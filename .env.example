# Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=

# DeepSeek Platform API key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional: enables analysis of video attachments
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Editable Markdown persona card
PERSONA_FILE=personas/jiibao.md

# Optional: comma-separated channel IDs. Empty means all guild text channels.
ALLOWED_CHANNEL_IDS=

# Persistent per-server settings and command registration
DATABASE_PATH=data/bot.sqlite
REGISTER_COMMANDS=true
REQUIRE_CHANNEL_OPT_IN=false

# Natural participation controls
AUTO_REPLY_ENABLED=true
AUTO_REPLY_PROBABILITY=0.15
AUTO_REPLY_COOLDOWN_SECONDS=45
MIN_MESSAGES_BEFORE_AUTO_REPLY=3
MEMORY_MESSAGES=24
MEMORY_TTL_MINUTES=30

# Video controls
MAX_VIDEO_MB=25
VIDEO_PROCESSING_TIMEOUT_SECONDS=180

# Discord messages are capped at 2,000 characters; leave a small safety margin.
MAX_REPLY_CHARS=1900
